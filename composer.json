{
  "name": "cubadevops/flexi-module-logging",
  "description": "Logging module for Flexi Framework with PSR-3 support",
  "version": "2.0.0",
  "type": "flexi-module",
  "license": "MIT",
  "keywords": [
    "flexi",
    "module",
    "logging",
    "psr-3",
    "logger"
  ],
  "authors": [
    {
      "name": "Carlos Batista",
      "email": "info@carlosbatista.dev",
      "homepage": "https://carlosbatista.dev"
    }
  ],
  "require": {
    "php": ">=7.4",
    "flexi/contracts": "^5.2.1",
    "psr/log": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Flexi\\Modules\\Logging\\": ""
    }
  },
  "extra": {
    "flexi": {
      "module-name": "Logging",
      "module-type": "infrastructure",
      "config-files": [
        "Config/listeners.json",
        "Config/services.json"
      ],
      "provides": [
        "logging",
        "psr-3-logger",
        "event-logging"
      ],
      "schema-version": 1,
      "compatibility": {
        "core": "^3.2"
      }
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flexi\\Modules\\Logging\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  }
}
